{
  "id": "/",
  "name": "triauth authenticator",
  "short_name": "triauth",
  "description": "Sign in to websites with just a click, no passwords. Your keys stay on your device.",
  "start_url": "/index.html",
  "scope": "/index.html",
  "display": "standalone",
  "theme_color": "#2563eb",
  "background_color": "#ffffff",
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/assets/triauth-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/triauth-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/triauth-icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/triauth-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
